# SMTP provider settings (SMTP2GO, Mailjet, or another SMTP service)
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=contact@your-domain.com
SMTP_NOTIFICATION_EMAIL=contact@your-domain.com,manager@your-domain.com

# Existing application settings
PUBLIC_SITE_URL=https://theballplex.com
